{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "disableBundledSkills": true,
  "permissions": {
    "allow": [
      "Bash(python3:*)",
      "Bash(python:*)",
      "Bash(pip install:*)",
      "Bash(ruff:*)",
      "Bash(alembic:*)",
      "Bash(uvicorn:*)",
      "Bash(pytest:*)",
      "Bash(node --check:*)",
      "Bash(curl -s http://127.0.0.1:*)",
      "Bash(curl -s http://localhost:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(mkdir:*)",
      "Bash(diff:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git stash:*)",
      "Bash(git worktree:*)",
      "Bash(git rev-parse:*)",
      "Bash(gh api repos/Larspolo/travel-aggregator:*)",
      "Bash(gh api search/issues:*)",
      "Bash(gh issue:*)",
      "Bash(gh pr:*)",
      "Bash(gh label:*)",
      "Bash(gh run:*)",
      "Bash(gh search:*)",
      "mcp__github__issue_read",
      "mcp__github__issue_write",
      "mcp__github__add_issue_comment",
      "mcp__github__update_issue_comment",
      "mcp__github__list_issues",
      "mcp__github__search_issues",
      "mcp__github__search_pull_requests",
      "mcp__github__list_pull_requests",
      "mcp__github__pull_request_read",
      "mcp__github__create_pull_request",
      "mcp__github__update_pull_request",
      "mcp__github__merge_pull_request",
      "mcp__github__add_reply_to_pull_request_comment",
      "mcp__github__sub_issue_write",
      "mcp__github__get_label",
      "mcp__github__get_check_run",
      "mcp__github__get_job_logs",
      "mcp__github__actions_list",
      "mcp__github__actions_get",
      "mcp__github__list_commits",
      "mcp__github__get_me"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(gh repo delete:*)",
      "Agent",
      "Agent(claude)",
      "Agent(claude-code-guide)",
      "Agent(Explore)",
      "Agent(general-purpose)",
      "Agent(Plan)",
      "Agent(statusline-setup)",
      "Artifact",
      "ArtifactComments",
      "ArtifactData",
      "CronCreate",
      "CronDelete",
      "CronList",
      "DesignSync",
      "EnterPlanMode",
      "EnterWorktree",
      "ExitPlanMode",
      "ExitWorktree",
      "Glob",
      "ListAgents",
      "ListConnectors",
      "ListMcpResourcesTool",
      "ListPlugins",
      "ListSkills",
      "mcp__Claude_Docs",
      "mcp__ccd_session",
      "mcp__claude-code-remote",
      "NotebookEdit",
      "PushNotification",
      "ReadMcpResourceDirTool",
      "ReadMcpResourceTool",
      "ReadNotifications",
      "ReportFindings",
      "ScheduleWakeup",
      "SearchMcpRegistry",
      "SearchPlugins",
      "SearchSkills",
      "SendUserFile",
      "ShowOnboardingRolePicker",
      "SuggestConnectors",
      "SuggestPluginInstall",
      "SuggestSkills",
      "TaskCreate",
      "TaskGet",
      "TaskList",
      "TaskUpdate",
      "Workflow"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/guard-main.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/guard-shell.sh"
          }
        ]
      },
      {
        "matcher": "mcp__github__issue_write|mcp__github__add_issue_comment|mcp__github__create_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/guard-body.sh"
          }
        ]
      }
    ]
  },
  "skillOverrides": {
    "anthropic-skills:built-in-browser": "off",
    "anthropic-skills:chrome-browser": "off",
    "anthropic-skills:computer-use": "off",
    "anthropic-skills:docs": "off",
    "anthropic-skills:docx": "off",
    "anthropic-skills:pdf": "off",
    "anthropic-skills:pptx": "off",
    "anthropic-skills:xlsx": "off",
    "demo": "user-invocable-only",
    "human": "user-invocable-only",
    "new-project": "user-invocable-only",
    "plugin-authoring": "off",
    "session-start-hook": "off"
  }
}
