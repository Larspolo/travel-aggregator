# Copy to .env for `docker compose up --build`. Never commit .env.
POSTGRES_USER=travel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=travel
DATABASE_URL=postgresql+psycopg://travel:change-me@db:5432/travel
# The session key of the login (trip:list): a long random value, for example from: openssl rand -hex 32
SECRET_KEY=change-me
# The password hash of the owner login. Make it with: python3 -m app.auth 'PASSWORD'
# Keep the single quotes: then the $ signs need no doubling.
OWNER_PASSWORD_HASH='pbkdf2_sha256$600000$...$...'
# The port on this computer
APP_PORT=8000
# The SMTP server of the price-drop e-mail (Settings, channel "email"). Empty SMTP_HOST: no e-mail.
# Port 587 uses STARTTLS, port 465 uses SSL. The password stays here, never in the database.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
