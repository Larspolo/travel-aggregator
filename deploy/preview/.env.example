# Copy to .env next to docker-compose.yml on the server. Never commit .env.
POSTGRES_USER=travel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=travel
DATABASE_URL=postgresql+psycopg://travel:change-me@db:5432/travel
# The session key of the login (trip:list): a long random value, for example from: openssl rand -hex 32
SECRET_KEY=change-me
# The password hash of the owner login. Make it with: python3 -m app.auth 'PASSWORD'
# Keep the single quotes: then the $ signs need no doubling.
OWNER_PASSWORD_HASH='pbkdf2_sha256$600000$...$...'
# Web Push of the price-drop messages (optional; the settings page then shows "Turn on push on this device").
# Make a key pair with: python3 -m app.notify  (it prints the two lines; keep the private key secret).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# The contact of the sender for the push services: a mailto: address.
VAPID_SUBJECT=mailto:you@example.com
# The SMTP server of the price-drop e-mail (Settings, channel "email"). Empty SMTP_HOST: no e-mail.
# Port 587 uses STARTTLS, port 465 uses SSL. The password stays here, never in the database.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# STARTTLS on port 587 (default true). The self-hosted relay `mail` of docker-compose.yml has no TLS on the
# internal network: SMTP_HOST=mail, SMTP_PORT=587, SMTP_STARTTLS=false, empty SMTP_USER, SMTP_FROM=<any address>.
# The relay sends straight to the receiving server: the mail can go to the spam folder (#525).
SMTP_STARTTLS=true
# The sender domain of the relay `mail` (for example travel-preview.larspolo.nl).
MAIL_DOMAIN=travel-preview.larspolo.nl
