tailsIcon\": {\"iconGroup\": \"Mobility\", \"iconName\": \"journey\"}, \"passengersQuantityLabel\": \"Pour 1 voyageur\", \"proposalIcon\": {\"semanticLabel\": \"TGV_INOUI\", \"icon\": {\"iconGroup\": \"Brand\", \"iconName\": \"tgv_inoui\"}}, \"proposalType\": \"STANDARD\"}], \"pagination\": {\"previous\": {\"label\": \"Afficher le jour précédent\", \"changeDay\": true}, \"next\": {\"label\": \"Afficher les trajets suivants\", \"changeDay\": false}}, \"pricesRange\": {\"origin\": \"Paris\", \"destination\": \"Lyon\", \"actionTitle\": \"Prix minimum et maximum sur ce trajet\", \"actionLabel\": \"Voir les prix\", \"pricesRangeItems\": [{\"transporter\": {\"modeIcon\": {\"iconGroup\": \"Transports\", \"iconName\": \"train\"}, \"logo\": \"ouigo_grande_vitesse\", \"description\": \"OUIGO\", \"semanticDescription\": \"OUIGO Grande Vitesse\"}, \"priceMin\": {\"priceLabel\": \"10 €\", \"label\": \"\"}, \"priceMax\": {\"priceLabel\": \"99 €\", \"label\": \"Selon options\"}}, {\"transporter\": {\"modeIcon\": {\"iconGroup\": \"Transports\", \"iconName\": \"transilien_simple\"}, \"logo\": \"ouigo_vitesse_classique\", \"description\": \"OUIGO TRAIN CLASSIQUE\", \"semanticDescription\": \"OUIGO TRAIN CLASSIQUE\"}, \"priceMin\": {\"priceLabel\": \"10 €\", \"label\": \"\"}, \"priceMax\": {\"priceLabel\": \"49 €\", \"label\": \"Selon options\"}}, {\"transporter\": {\"modeIcon\": {\"iconGroup\": \"Transports\", \"iconName\": \"train\"}, \"logo\": \"tgv_inoui\", \"description\": \"TGV INOUI\", \"semanticDescription\": \"TGV INOUI\"}, \"priceMin\": {\"priceLabel\": \"25 €\", \"label\": \"\"}, \"priceMax\": {\"priceLabel\": \"115 €\", \"label\": \"Selon options\"}}], \"currencyIcon\": {\"iconGroup\": \"Divers\", \"iconName\": \"euro\"}, \"pricesRangeDetails\": {\"title\": \"Prix min. et max. sur ce trajet\", \"linkLabel\": \"Fermer\", \"description\": \"Voici les prix minimum et maximum pouvant être proposés sur ce trajet :\", \"informationFirst\": \"Pour un adulte, en 2de classe, hors promotion.\", \"informationSecond\": \"Prix minimum et maximum TTC pour un aller simple sur la période choisie. Sous réserve de disponibilité.\", \"lowestPriceLabel\": \"Comment trouver des petits prix ?\", \"lowestPriceDescription\": \"Réservation anticipée ou achat de dernière minute, pour les vacances ou en période creuse : il existe des solutions pour trouver des billets à petit prix toute l'année.\", \"lowestPriceLinkText\": \"Découvrir les solutions\", \"lowestPriceLink\": \"https://www.sncf-connect.com/train/bons-plans/solutions-petits-prix\", \"feedbackLabel\": \"Cette information vous est-elle utile ?\", \"feedbackYes\": \"Oui\", \"feedbackNo\": \"Non\", \"feedbackThanks\": \"Merci\", \"minimum\": \"Minimum\", \"maximum\": \"Maximum\", \"providedBy\": \"Opéré par\"}}, \"warnings\": [], \"proposalsSortExplanation\": {\"message\": \"Nos offres sont présentées par horaires de départ.\", \"clickableMessage\": \"Voir conditions\", \"explanation\": {\"title\": \"Conditions générales de présentation des offres ferroviaires\", \"sections\": [{\"subtitle\": \"1. Classement des offres\", \"paragraphs\": [{\"text\": \"SNCF Connect permet à ses utilisateurs, pour un trajet donné, de trouver les offres des transporteurs ferroviaires. Pour ce faire, SNCF Connect adopte un classement par défaut dont le critère est l’heure de départ du train.\", \"endParagraphBulletElements\": []}, {\"text\": \"Aucun autre critère, rémunération ou autre, ne conditionne la présentation des offres.\", \"endParagraphBulletElements\": []}]}, {\"subtitle\": \"2. Nos partenaires ferroviaires\", \"paragraphs\": [{\"text\": \"SNCF Connect propose au nom et pour le compte de ses partenaires, via un mandat de distribution rémunéré, leurs offres. Ces partenaires sont notamment et sans que cette liste soit exhaustive :\", \"endParagraphBulletElements\": [\"SNCF,\", \"OUIGO,\", \"Transdev\"]}]}, {\"subtitle\": \"3. La périodicité et la méthode d’actualisation des offres présentées\", \"paragraphs\": [{\"text\": \"Afin de proposer à sa clientèle les meilleures offres, SNCF Connect utilise des bases de données de réservation en temps réel, par accès direct à chaque système de réservation des transporteurs. Notre moteur de recherche est donc une passerelle entre les utilisateurs et lesdits systèmes.\", \"endParagraphBulletElements\": []}]}]}}, \"messages\": [], \"proposalsExpirationDate\": \"2026-11-08T11:24:56.019492703+01:00\", \"filters\": {\"transporterLabels\": [\"TER\", \"TGV INOUI\", \"OUIGO\"]}, \"isEligibleToLowPriceAlertSuggestion\": true}, \"status\": \"RESULTS\", \"informationBanners\": [], \"longDistanceFiltersSection\": {\"connectionTime\": {\"title\": \"Temps de correspondance\", \"description\": [\"Voyageur à mobilité réduite, famille nombreuse ou juste envie de prendre votre temps ?\", \"Renseignez un temps de correspondance minimum pour votre changement de train (de 15 min à 2h30).\"], \"numberPicker\": {\"min\": 15, \"max\": 150, \"step\": 15, \"addButtonAriaLabel\": \"Ajouter du temps\", \"lessButtonAriaLabel\": \"Retirer du temps\", \"maxLimitReachedAriaLabel\": \"Augmentez le temps, non disponible, maximum 2 minutes pour faire une correspondance.\", \"minLimitReachedAriaLabel\": \"Réduire le temps, non disponible, minimum 15  minutes pour faire une correspondance.\"}}}}, \"metadata\": {\"datalayer\": {\"stringValues\": {\"tealium_account\": \"e-voyageurs-sncf\", \"tealium_profile\": \"s2s\", \"tealium_event\": \"PAGE-DevisAller\", \"page_name\": \"DevisAller\", \"page_url\": \"/home/shop/results/outward\", \"page_previous\": \"DevisAller\", \"page_section_type\": \"Achat\", \"page_seo_type\": \"generic\", \"page_event\": \"search\", \"user_visitor_id\": \"35fb817654ba4fb7ad40aac6d3ec8755\", \"user_visitor_type\": \"0\", \"user_signedin\": \"0\", \"user_device_os_version\": \"Chrome\", \"user_device_type\": \"desktop\", \"user_device_app_version\": \"815b9e79a1\", \"user_device_geolocation_activated\": \"false\", \"user_device_language\": \"fr\",