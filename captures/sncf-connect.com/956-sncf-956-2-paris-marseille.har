tComfortClassOffers\": {\"title\": \"1re classe\", \"offers\": [], \"bestPriceLabelPrefix\": \"dès\"}, \"secondComfortClassOffers\": {\"title\": \"2de classe\", \"accessibilityTitle\": \"Seconde classe\", \"offers\": [{\"id\": \"1|20a20f74-3b4b-4b16-8e34-b30b80589d9c|a9a6d8e0-8e10-4744-9a11-d0953ae69b36\", \"header\": {\"title\": \"OUIGO PLUS\", \"accessibilityTitle\": \"OUIGO PLUS\", \"type\": \"SECOND\"}, \"type\": \"NORMAL\", \"comfortClass\": {\"code\": \"SECOND\", \"label\": \"OUIGO PLUS\", \"accessibilityLabel\": \"OUIGO PLUS\"}, \"priceLabel\": \"25 €\", \"title\": \"Modifiable sous conditions\", \"travelersFares\": [{\"id\": \"1|20a20f74-3b4b-4b16-8e34-b30b80589d9c|a9a6d8e0-8e10-4744-9a11-d0953ae69b36_0f506669-23c1-4d8d-a560-a84c81199f99\", \"travelerDescription\": \"30 - 59 ans\", \"subtitles\": [\"Offre OUIGO PLUS Adulte\"], \"priceLabel\": \"25 €\", \"segmentFares\": [{\"transporterName\": \"OUIGO\", \"transporterSemanticName\": \"OUIGO Grande Vitesse\", \"transporterType\": \"TRAIN\", \"transporterDescription\": \"7831\", \"comfort\": \"2de\", \"fareName\": \"Offre OUIGO PLUS Adulte\", \"fareConditions\": \"Billet non annulable, non remboursable. Échangeable ou modifiable en ligne jusqu'à 30 min avant le départ de votre train, sous conditions avec frais d'échange de maximum 19€ par trajet et par voyageur (les frais d’échange ne s’appliquent pas avec l’option OuigoFlex). S'ajoute à ces frais, l'éventuelle différence tarifaire entre l'ancien et le nouveau billet. Si la différence tarifaire est négative, celle-ci n’est pas remboursée. Toute modification s'applique par trajet et à l'ensemble des voyageurs. Le billet est disponible à partir de 4 jours avant le départ du train. L'embarquement est ouvert 30 minutes avant le départ du train et l'accès au train est refusé 5 minutes avant le départ. Présentation d'un justificatif d'identité obligatoire. \", \"fareSemanticConditions\": \"Billet non annulable, non remboursable. Échangeable ou modifiable en ligne jusqu'à 30 min avant le départ de votre train, sous conditions avec frais d'échange de maximum 19€ par trajet et par voyageur (les frais d’échange ne s’appliquent pas avec l’option OuigoFlex). S'ajoute à ces frais, l'éventuelle différence tarifaire entre l'ancien et le nouveau billet. Si la différence tarifaire est négative, celle-ci n’est pas remboursée. Toute modification s'applique par trajet et à l'ensemble des voyageurs. Le billet est disponible à partir de 4 jours avant le départ du train. L'embarquement est ouvert 30 minutes avant le départ du train et l'accès au train est refusé 5 minutes avant le départ. Présentation d'un justificatif d'identité obligatoire. \", \"price\": \"25 €\", \"segmentIcons\": []}], \"travelerIcon\": \"TRAVELER\"}], \"segmentServices\": [{\"segmentId\": \"e2d8dcda-cfd2-493c-9821-63e0d6a9d960\", \"flexibilitySection\": {\"code\": \"OUIGO_FLEX\", \"title\": \"Flexibilité\", \"flexibility\": {\"iconId\": {\"iconGroup\": \"NavigationAndAction\", \"iconName\": \"exchange\"}, \"title\": \"OUIGOFLEX\", \"price\": {\"value\": 9, \"currency\": \"EUR\"}, \"semanticPriceLabel\": \"Plus 9 euros par adulte\", \"description\": \"Échangez vos billets sans frais jusqu’à 30 min avant le départ du train.\", \"toggleLabel\": \"Ajouter cette option\", \"toggleSubtitleLabel\": \"9 €/adulte, gratuit pour les enfants\", \"infoIconAriaLabel\": \"En savoir plus\"}, \"details\": {\"title\": \"OUIGOFLEX\", \"subtitle\": \"Réservez l’esprit tranquille avec OUIGOFLEX\", \"paragraphs\": [\"Avec OUIGOFLEX, vous pouvez échanger vos billets sans frais jusqu’à 30 min avant le départ du train ! Sans cette option, des frais d’échange de 19 € max s’appliquent par voyageur et par trajet.\", \"Les billets restent non annulables et non remboursables.\", \"L’option OUIGOFLEX doit être achetée pour l’ensemble des voyageurs. Elle coûte 9 € par voyageur adulte (gratuite pour les enfants). Elle ne peut pas être achetée en après-vente.\"]}}, \"flexibilityServices\": {\"flexibilityA