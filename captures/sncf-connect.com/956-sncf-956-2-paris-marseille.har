l\": \"Grand bagage (ou autre bagage en plus)\", \"label\": \"Grand bagage (ou autre bagage en +)\", \"iconId\": {\"iconGroup\": \"Services\", \"iconName\": \"luggages_on_board\"}, \"available\": true}, {\"label\": \"Wifi et divertissement\", \"iconId\": {\"iconGroup\": \"Services\", \"iconName\": \"entertainment\"}, \"available\": true}], \"accessibilityTitle\": \"Nos services en seconde\"}, \"extraServices\": {\"title\": \"Et pour + de confort\", \"services\": [{\"label\": \"Échange sans frais\", \"price\": \"+9 €\", \"iconId\": {\"iconGroup\": \"NavigationAndAction\", \"iconName\": \"exchange\"}, \"available\": true}, {\"label\": \"Choix de la place (avec prise, standard ou solo)\", \"price\": \"0 €\", \"iconId\": {\"iconGroup\": \"Placement\", \"iconName\": \"seatmap_ouigo\"}, \"available\": true}, {\"label\": \"Bagage supplémentaire\", \"price\": \"+5 €\", \"iconId\": {\"iconGroup\": \"NavigationAndAction\", \"iconName\": \"add-a-luggage\"}, \"available\": true}, {\"label\": \"Poussette\", \"price\": \"0 €\", \"iconId\": {\"iconGroup\": \"Area\", \"iconName\": \"family_area\"}, \"available\": true}, {\"label\": \"Vélo plié sous housse\", \"price\": \"+5 €\", \"iconId\": {\"iconGroup\": \"Services\", \"iconName\": \"bike_cover\"}, \"available\": true}], \"accessibilityTitle\": \"Et pour plus de confort\"}, \"header\": {\"title\": \"OUIGO PLUS\", \"accessibilityTitle\": \"OUIGO PLUS\", \"subtitle\": \"Modifiable sous conditions\", \"type\": \"SECOND\"}, \"extraMessages\": [], \"headerTags\": []}, \"transportersFareConditions\": [], \"defaultButtonLabel\": \"Choisir cet aller à\", \"inwardButtonLabel\": \"Choisir ce retour à\", \"highlightOffer\": {\"title\": \"Bon plan\", \"subtitle\": \"Toutes vos options incluses\"}}, {\"id\": \"1|20a20f74-3b4b-4b16-8e34-b30b80589d9c|eb11d7cd-6115-423a-a2de-8a60d733bd34\", \"header\": {\"title\": \"OUIGO ESSENTIEL\", \"accessibilityTitle\": \"OUIGO ESSENTIEL\", \"type\": \"SECOND\"}, \"type\": \"NORMAL\", \"comfortClass\": {\"code\": \"SECOND\", \"label\": \"OUIGO ESSENTIEL\", \"accessibilityLabel\": \"OUIGO ESSENTIEL\"}, \"priceLabel\": \"16 €\", \"title\": \"Modifiable sous conditions\", \"travelersFares\": [{\"id\": \"1|20a20f74-3b4b-4b16-8e34-b30b80589d9c|eb11d7cd-6115-423a-a2de-8a60d733bd34_870e51f2-ba43-46be-8fb4-6f2434d8ef60\", \"travelerDescription\": \"30 - 59 ans\", \"subtitles\": [\"Offre Essentiel Adulte\"], \"priceLabel\": \"16 €\", \"segmentFares\": [{\"transporterName\": \"OUIGO\", \"transporterSemanticName\": \"OUIGO Grande Vitesse\", \"transporterType\": \"TRAIN\", \"transporterDescription\": \"7831\", \"comfort\": \"2de\", \"fareName\": \"Offre Essentiel Adulte\", \"fareConditions\": \"Billet non annulable, non remboursable. Échangeable ou modifiable en ligne jusqu'à 30 min avant le départ de votre train, sous conditions avec frais d'échange de maximum 19€ par trajet et par voyageur (les frais d’échange ne s’appliquent pas avec l’option OuigoFlex). S'ajoute à ces frais, l'éventuelle différence tarifaire entre l'ancien et le nouveau billet. Si la différence tarifaire est négative, celle-ci n’est pas remboursée. Toute modification s'applique par trajet et à l'ensemble des voyageurs. Le billet est disponible à partir de 4 jours avant le départ du train. L'embarquement est ouvert 30 minutes avant le départ du train et l'accès au train est refusé 5 minutes avant le départ. Présentation d'un justificatif d'identité obligatoire. \", \"fareSemanticConditions\": \"Billet non annulable, non remboursable. Échangeable ou modifiable en ligne jusqu'à 30 min avant le départ de votre train, sous conditions avec frais d'échange de maximum 19€ par trajet et par voyageur (les frais d’échange ne s’appliquent pas avec l’option OuigoFlex). S'ajoute à ces frais, l'éventuelle différence tarifaire entre l'ancien et le nouveau billet. Si la différence tarifaire est négative, celle-ci n’est pas remboursée. Toute modification s'applique par trajet et à l'ensemble des voyageurs. Le billet est disponible à partir de 4 jours avant le départ du train. L'embarquement est ouvert 30 minutes avant le départ du train et l'accès au train est refusé 5 minutes avant le départ. Présentation d'un justificatif d'identité obligatoire. \", \"price\": \"16 €\", \"segmentIcons\": []}], \"travelerIcon\": \"TRAVELER\"}], \"segmentServices\": [{\"segmentId\": \"e2d8dcda-cfd2-493c-9821-63e0d6a9d960\", \"flexibilitySection\": {\"code\": \"OUIGO_FLEX\", \"title\": \"Flexibilité\", \"flexibility\": {\"iconId\": {\"iconGroup\": \"NavigationAndAction\", \"iconName\": \"exchange\"}, \"title\": \"OUIGOFLEX\", \"price\": {\"value\": 9, \"currency\": \"EUR\"}, \"semanticPriceLabel\": \"Plus 9 euros par adulte\", \"description\": \"Échangez vos billets sans frais jusqu’à 30 min avant le départ du train.\", \"toggleLabel\": \"Ajouter cette option\", \"toggleSubtitleLabel\": \"9 €/adulte, gratuit pour les enfants\", \"infoIconAriaLabel\": \"En savoir plus\"}, \"details\": {\"title\": \"OUIGOFLEX\", \"subtitle\": \"Réservez l’esprit tranquille avec OUIGOFLEX\", \"paragraphs\": [\"Avec OUIGOFLEX, vous pouvez échanger vos billets sans frais jusqu’à 30 min avant le départ du train ! Sans cette option, des frais d’échange de 19 € max s’appliquent par voyageur et par trajet.\", \"Les billets restent non annulables et non remboursables.\", \"L’option OUIGOFLEX doit être achetée pour l’ensemble des voyageurs. Elle coûte 9 € par voyageur adulte (gratuite pour les enfants). Elle ne peut pas être achetée en après-vente.\"]}}, \"flexibilityServices\": {\"flexibilityAdditionalService\": {\"code\": \"OUIGO_FLEX\", \"title\": \"Flexibilité\", \"flexibility\": {\"iconId\": {\"iconGroup\": \"NavigationAndAction\", \"iconName\": \"exchange\"}, \"title\": \"OUIGOFLEX\", \"price\": {\"value\": 9, \"currency\": \"EUR\"}, \"semanticPriceLabel\": \"Plus 9 euros par adulte\", \"description\": \"Échangez vos billets sans frais jusqu’à 30 min avant le départ du train.\", \"toggleLabel\": \"Ajouter cette option\", \"tog