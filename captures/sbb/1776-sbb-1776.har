     "bodySize": 4783,
     "postData": {
      "mimeType": "application/json",
      "text": "{\"query\": \"\\n    query Trips($input: TripInput!, $pagingCursor: String, $language: LanguageEnum!) {\\n  trips(tripInput: $input, pagingCursor: $pagingCursor, language: $language) {\\n    trips {\\n      ...TripFields\\n    }\\n    paginationCursor {\\n      previous\\n      next\\n    }\\n  }\\n}\\n    fragment ArrivalDepartureFields on ScheduledStopPointDetail {\\n  time\\n  delay\\n  delayText\\n  quayFormatted\\n  quayChanged\\n  quayChangedText\\n}\\nfragment NoticesFields on Notice {\\n  name\\n  text {\\n    template\\n    arguments {\\n      type\\n      values\\n    }\\n  }\\n  type\\n  priority\\n  advertised\\n}\\nfragment BoardingAFields on AccessibilityBoardingAlighting {\\n  limitation\\n  name\\n  description\\n  assistanceService {\\n    template\\n    arguments {\\n      type\\n      values\\n    }\\n  }\\n}\\nfragment ServiceProductFields on ServiceProduct {\\n  name\\n  line\\n  number\\n  vehicleMode\\n  vehicleSubModeShortName\\n  corporateIdentityIcon\\n  corporateIdentityPictogram\\n}\\nfragment SituationFields on PTSituation {\\n  cause\\n  broadcastMessages {\\n    id\\n    priority\\n    title\\n    detail\\n    detailShort\\n    distributionPeriod {\\n      startDate\\n      endDate\\n    }\\n    audiences {\\n      urls {\\n        name\\n        url\\n      }\\n    }\\n  }\\n  affectedStopPointFromIdx\\n  affectedStopPointToIdx\\n}\\nfragment TripStatusFields on TripStatus {\\n  alternative\\n  alternativeText\\n  cancelled\\n  cancelledText\\n  partiallyCancelled\\n  delayed\\n  delayedUnknown\\n  quayChanged\\n  cancelledExpected\\n}\\nfragment TripFields on Trip {\\n  id\\n  legs {\\n    duration\\n    id\\n    ... on AccessLeg {\\n      __typename\\n      duration\\n      distance\\n      start {\\n        __typename\\n        id\\n        name\\n      }\\n      end {\\n        __typename\\n        id\\n        name\\n      }\\n    }\\n    ... on PTConnectionLeg {\\n      __typename\\n      duration\\n      start {\\n        __typename\\n        id\\n        name\\n      }\\n      end {\\n        __typename\\n        id\\n        name\\n      }\\n      notices {\\n        ...NoticesFields\\n      }\\n    }\\n    ... on AlternativeModeLeg {\\n      __typename\\n      mode\\n      duration\\n    }\\n    ... on PTRideLeg {\\n      __typename\\n      duration\\n      start {\\n        __typename\\n        id\\n        name\\n      }\\n      end {\\n        __typename\\n        id\\n        name\\n      }\\n      arrival {\\n        ...ArrivalDepartureFields\\n      }\\n      departure {\\n        ...ArrivalDepartureFields\\n      }\\n      serviceJourney {\\n        id\\n        stopPoints {\\n          place {\\n            id\\n            name\\n          }\\n          occupancy {\\n            firstClass\\n            secondClass\\n          }\\n          accessibilityBoardingAlighting {\\n            ...BoardingAFields\\n          }\\n          stopStatus\\n          stopStatusFormatted\\n          delayUndefined\\n        }\\n        serviceProducts {\\n          ...ServiceProductFields\\n          routeIndexFrom\\n          routeIndexTo\\n        }\\n        direction\\n        serviceAlteration {\\n          cancelled\\n          partiallyCancelled\\n          redirected\\n          redirectedText\\n          reachable\\n          reachableText\\n          delayText\\n          unplannedStopPointsText\\n          quayChangedText\\n          cancelledExpected\\n        }\\n        situations {\\n          ...SituationFields\\n        }\\n        notices {\\n          ...NoticesFields\\n        }\\n        quayTypeName\\n        quayTypeShortName\\n      }\\n    }\\n  }\\n  situations {\\n    ...SituationFields\\n  }\\n  notices {\\n    ...NoticesFields\\n  }\\n  valid\\n  isBuyable\\n  summary {\\n    duration\\n    arrival {\\n      ...ArrivalDepartureFields\\n    }\\n    arrivalWalk\\n    lastStopPlace {\\n      __typename\\n      id\\n      name\\n      canton\\n    }\\n    tripStatus {\\n      ...TripStatusFields\\n    }\\n    departure {\\n      ...ArrivalDepartureFields\\n    }\\n    departureWalk\\n    firstStopPlace {\\n      __typename\\n      id\\n      name\\n      canton\\n    }\\n    product {\\n      ...ServiceProductFields\\n    }\\n    direction\\n    occupancy {\\n      firstClass\\n      secondClass\\n    }\\n    tripStatus {\\n      ...TripStatusFields\\n    }\\n    boardingAlightingAccessibility {\\n      ...BoardingAFields\\n    }\\n    international\\n  }\\n  searchHint\\n}\", \"variables\": {\"input\": {\"places\": [{\"type\": \"ID\", \"value\": \"8500010\"}, {\"type\": \"ID\", \"value\": \"8503000\"}], \"time\": {\"date\": \"2026-12-08\", \"time\": \"08:00\", \"type\": \"DEPARTURE\"}, \"includeEconomic\": false, \"directConnection\": false, \"includeAccessibility\": \"NONE\", \"includeNoticeAttributes\": [], \"includeTransportModes\": [\"HIGH_SPEED_TRAIN\", \"INTERCITY\", \"INTERREGIO\", \"REGIO\", \"URBAN_TRAIN\", \"SPECIAL_TRAIN\", \"SHIP\", \"BUS\", \"TRAMWAY\", \"CABLEWAY_GONDOLA_CHAIRLIFT_FUNICULAR\"], \"includeUnsharp\": false, \"occupancy\": \"ALL\", \"walkSpeed\": 100}, \"language\": \"EN\"}}"
