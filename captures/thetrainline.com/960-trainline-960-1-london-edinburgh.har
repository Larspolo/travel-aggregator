}, {\"title\": \"VALIDITY\", \"description\": \"You must travel on the date, time and trains specified. You may not start, break and resume, or end your journey at any intermediate station except to change to/from connecting trains as shown on the ticket(s) or other valid travel itinerary.\"}, {\"title\": \"BOOKING\", \"description\": \"Tickets must be purchased in advance of travel, subject to availability.\"}, {\"title\": \"REFUNDS\", \"description\": \"No refunds available.\"}, {\"title\": \"AMENDING YOUR BOOKING\", \"description\": \"Yes - date/time of tickets can be changed up until time of departure (except if you have chosen to print your own tickets) subject to an administration fee of up to GBP 10.00 per ticket per person and any difference in fares. If you change to a train on which a cheaper fare is available, the difference will not be refunded. Not possible to change the origin or destination.\"}, {\"title\": \"DISCOUNTS\", \"description\": \"Railcard discounts apply.\"}, {\"title\": \"CODE\", \"description\": \"BTT\"}, {\"title\": \"ACCESSIBILITY\", \"description\": \"View information about wheelchair spaces and accessibility on board your train here www.nationalrail.co.uk/on-the-train/accessible-train-travel-and-facilities. Find out how to book travel assistance here www.nationalrail.co.uk/help-and-assistance/passenger-assist.\"}], \"validityPeriods\": {\"outward\": \"P1D\"}, \"conditionsSummary\": \"Specified train only. No refunds.\", \"secondaryFare\": false, \"farePricingCategory\": \"default\"}, \"d7c08e71-c150-433e-ab22-975f2b08cc08\": {\"id\": \"d7c08e71-c150-433e-ab22-975f2b08cc08\", \"name\": \"Advance Single\", \"code\": \"urn:trainline:atoc:fare:BTU\", \"conditions\": [{\"title\": \"TICKET TYPE\", \"description\": \"ADVANCE\"}, {\"title\": \"DESCRIPTION\", \"description\": \"Non-refundable ticket, only valid for the date, time and trains specified.\"}, {\"title\": \"VALIDITY\", \"description\": \"You must travel on the date, time and trains specified. You may not start, break and resume, or end your journey at any intermediate station except to change to/from connecting trains as shown on the ticket(s) or other valid travel itinerary.\"}, {\"title\": \"BOOKING\", \"description\": \"Tickets must be purchased in advance of travel, subject to availability.\"}, {\"title\": \"REFUNDS\", \"description\": \"No refunds available.\"}, {\"title\": \"AMENDING YOUR BOOKING\", \"description\": \"Yes - date/time of tickets can be changed up until time of departure (except if you have chosen to print your own tickets) subject to an administration fee of up to GBP 10.00 per ticket per person and any difference in fares. If you change to a train on which a cheaper fare is available, the difference will not be refunded. Not possible to change the origin or destination.\"}, {\"title\": \"DISCOUNTS\", \"description\": \"Railcard discounts apply.\"}, {\"title\": \"CODE\", \"description\": \"BTU\"}, {\"title\": \"ACCESSIBILITY\", \"description\": \"View information about wheelchair spaces and accessibility on board your train here www.nationalrail.co.uk/on-the-train/accessible-train-travel-and-facilities. Find out how to book travel assistance here www.nationalrail.co.uk/help-and-assistance/passenger-assist.\"}], \"validityPeriods\": {\"outward\": \"P1D\"}, \"conditionsSummary\": \"Specified train only. No refunds.\", \"secondaryFare\": false, \"farePricingCategory\": \"default\"}, \"655e98d3-f15a-4b5e-a1d4-1caaf29b6849\": {\"id\": \"655e98d3-f15a-4b5e-a1d4-1caaf29b6849\", \"name\": \"Advance Single\", \"code\": \"urn:trainline:atoc:fare:BUS\", \"conditions\": [{\"title\": \"DESCRIPTION\", \"description\": \"Non-refundable ticket, only valid for the date, time and trains specified.\"}, {\"title\": \"VALIDITY\", \"description\": \"You must travel on the date, time and trains specified. You may not start, break and resume, or end your journey at any intermediate station except to change to/from connecting trains as shown on the ticket(s) or other valid travel itinerary.\"}, {\"title\": \"BOOKING\", \"description\": \"Tickets must be purchased in advance of travel, subject to availability.\"}, {\"title\": \"REFUNDS\", \"description\": \"No refunds available.\"}, {\"title\": \"AMENDING YOUR BOOKING\", \"description\": \"Yes - date/time of tickets can be changed up until time of departure (or 18:00 the day before travel if you have chosen to print your own ticket(s)) subject to the payment up to GBP 10.00 fee per ticket per person and any difference in fares. If you change to a train on which a cheaper fare is available, the difference will not be refunded. Not possible to change the origin or destination.\"}, {\"title\": \"DISCOUNTS\", \"description\": \"Child discounts, 16-25 Railcard, Family and Friends Railcard (standard class only), Senior Railcard, Two Together Railcard, HM Forces and Disabled Persons Railcards discounts apply.\"}, {\"title\": \"CODE\", \"description\": \"BUS\"}, {\"title\": \"ACCESSIBILITY\", \"description\": \"View information about wheelchair spaces and accessibility on board your train here www.nationalrail.co.uk/on-the-train/accessible-train-travel-and-facilities. Find out how to book travel assistance here www.nationalrail.co.uk/help-and-assistance/passenger-assist.\"}], \"validityPeriods\": {\"outward\": \"P1D\"}, \"conditionsSummary\": \"Specified train only. No refunds.\", \"secondaryFare\": false, \"farePricingCategory\": \"default\"}, \"44c51c56-7c12-4bf3-8be9-03f5868ce944\": {\"id\": \"44c51c56-7c12-4bf3-8be9-03f5868ce944\", \"name\": \"Advance Single\", \"code\": \"urn:trainline:atoc:fare:BUU\", \"conditions\": [{\"title\": \"TICKET TYPE\", \"description\": \"ADVANCE\"}, {\"title\": \"DESCRIPTION\", \"description\": \"Non-refundable ticket, only valid for the date, time and trains specified.\"}, {\"title\": \"VALIDITY\", \"description\": \"You must travel on the date, time and trains specified. You may not start, break and resume, or end your journey at any intermediate station except to change to/from connecting trains as shown on the ticket(s) or other valid travel itinerary.\"}, {\"title\": \"BOOKING\", \"description\": \"Tickets must be purchased in advance of travel, subject to availability.\"}, {\"title\": \"REFUNDS\", \"description\": \"No refunds available.\"}, {\"title\": \"AMENDING YOUR BOOKING\", \"description\": \"Yes - date/time of tickets can be changed up until time of departure (except if you have chosen to print your own tickets) subject to an administration fee of up to GBP 10.00 per ticket per person and any difference in fares. If you change to a train on which a cheaper fare is available, the difference will not be refunded. Not possible to change the origin or destination.\"}, {\"title\": \"DISCOUNTS\", \"description\": \"Railcard discounts apply.\"}, {\"title\": \"CODE\", \"description\": \"BUU\"}, {\"title\": \"ACCESSIBILITY\", \"description\": \"View information about wheelchair spaces and accessibility on board your train here www.nationalrail.co.uk/on-the-train/accessible-train-travel-and-facilities. Find out how to book travel assistance here www.nationalrail.co.uk/help-and-assistance/passenger-assist.\"}], \"validityPeriods\": {\"outward\": \"P1D\"}, \"conditionsSummary\": \"Specified train only. No refunds.\", \"secondaryFare\": false, \"farePricingCategory\": \"default\"}, \"1e66bf7d-01ed-44ac-98b0-220a5da98734\": {\"id\": \"1e66bf7d-01ed-44ac-98b0-220a5da98734\", \"name\": \"70min Flex Single\", \"code\": \"urn:trainline:atoc:fare:DMN\", \"conditions\": [{\"title\": \"TICKET TYPE\", \"description\": \"70 Minute Flex\"}, {\"title\": \"DESCRIPTION\", \"description\": \"Non-refundable ticket, only valid for the date with some additional flexibility to travel on alternative LNER services either side of the booked service.\"}, {\"title\": \"VALIDITY\", \"description\": \"You must begin your journey on the booked service or another LNER service from the origin station up to 70 minutes before or 70 minutes after the departure time of the original first booked service and must travel such that their scheduled arrival time is within 180 minutes of the original booked arrival time.\"}, {\"title\": \"BOOKING\", \"description\": \"Must be booked in advance of travel, subject to availability.\"}, {\"title\": \"REFUNDS\", \"description\": \"No refunds available.\"}, {\"title\": \"AMENDING YOUR BOOKING\", \"description\": \"Customers have the ability to change the date or time of travel, beyond the level of flexibility provided by the ticket, but this must be prior to expiry of the booked departure validity window. After this, the ticket has no value and a new one must be purchased. The new journey must include the same origin and destination stations, as well as the same route and operator conditions. Customers will need to present the ticket(s) and reservation(s) when they request a change. This is subject to the payment up to GBP 10.00 fee per ticket per person and any difference in fares. If you change to a train on which a cheaper fare is available, the difference will not be refunded.\"}, {\"title\": \"DISCOUNTS\", \"description\": \"Child and railcard discounts apply.\"}, {\"title\": \"CODE\", \"description\": \"DMN\"}, {\"title\": \"ACCESSIBILITY\", \"description\": \"View information about wheelchair spaces and accessibility on board your train here www.nationalrail.co.uk/on-the-train/accessible-train-travel-and-facilities. Find out how to book travel assistance here www.nationalrail.co.uk/help-and-assistance/passenger-assist.\"}], \"validityPeriods\": {\"outward\": \"P1D\"}, \"conditionsSummary\": \"Flexibility to travel on LNER services within 70 minutes of the booked departure time. No refunds.\", \"secondaryFare\": false, \"farePricingCategory\": \"default\"}, \"7326427b-9aa0-4cef-9a29-eb36e289e996\": {\"id\": \"7326427b-9aa0-4cef-9a29-eb36e289e996\", \"name\": \"70min Flex Single\", \"code\": \"urn:trainline:atoc:fare:DMO\", \"conditions\": [{\